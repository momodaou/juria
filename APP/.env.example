# JURIA — variables d'environnement (copier en .env pour le local ; NE PAS committer .env)
PORT=8080

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juria
DB_USER=juria_app
DB_PASSWORD=changez-moi

# Clé de signature des jetons (générer une valeur forte, ex. openssl rand -base64 48)
JWT_SECRET=changez-moi-en-production

# En production (Cloud Run + Cloud SQL), DB_HOST prend la forme :
# DB_HOST=/cloudsql/PROJET:REGION:INSTANCE

# Assistant IA (optionnel). Sans clé : repli hors-ligne (aperçu simulé).
# Clé Google Gemini / Vertex AI :
IA_API_KEY=
IA_MODEL=gemini-1.5-flash
