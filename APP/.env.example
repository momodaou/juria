# JURIA — variables d'environnement (copier en .env pour le local ; NE PAS committer .env)
PORT=8080

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juria
DB_USER=juria_app
DB_PASSWORD=changez-moi

# Clé de signature des jetons (générer une valeur forte, ex. openssl rand -base64 48)
JWT_SECRET=changez-moi-en-production

# En production (Cloud Run + Cloud SQL), DB_HOST prend la forme :
# DB_HOST=/cloudsql/PROJET:REGION:INSTANCE

# Assistant IA (optionnel). Sans clé : repli hors-ligne (aperçu simulé).
# Clé Google Gemini / Vertex AI :
IA_API_KEY=
IA_MODEL=gemini-1.5-flash

# Origines autorisées pour CORS (virgules, sans espace autour des virgules).
# Par défaut si absent : frontend Cloud Run + localhost:4200 (dev local).
# À mettre à jour quand un domaine personnalisé est mappé.
ALLOWED_ORIGINS=https://juria-web-552099340909.europe-west1.run.app,http://localhost:4200

# URL du frontend (pour composer les liens envoyés par e-mail, ex. lien de
# réinitialisation de mot de passe). Par défaut si absent : URL Cloud Run.
FRONTEND_URL=https://juria-web-552099340909.europe-west1.run.app

# Envoi d'e-mails sortants (31/08/2026, réinitialisation de mot de passe +
# futurs envois de documents) — SMTP du cabinet chez Infomaniak, boîte
# dédiée (ex. noreply@jfcavocats-mali.com). Sans SMTP_HOST : repli qui
# journalise l'e-mail au lieu de l'envoyer (pas d'erreur bloquante).
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@jfcavocats-mali.com
